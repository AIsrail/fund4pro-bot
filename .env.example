BOT_TOKEN=
ANTHROPIC_API_KEY=

# Опционально — персистентное хранилище FSM (переживает рестарт процесса).
# Если пусто, используется MemoryStorage (состояния теряются при рестарте).
REDIS_URL=

# Лимит бесплатных полных версий документа (по умолчанию 2).
FULL_VERSION_LIMIT=2

# Сколько раз бот пытается автоматически исправить найденные red-flags
# перед тем, как показать их пользователю напрямую (по умолчанию 1).
RED_FLAG_AUTOFIX_ATTEMPTS=1

# --- Платежи (выключено по умолчанию) ---
# Установите true, когда будет готова платёжная логика (см. payments.py).
PAYMENT_ENABLED=false
# Оставьте пустым для оплаты через Telegram Stars, либо укажите токен
# провайдера из @BotFather -> Payments для классической оплаты картой.
PROVIDER_TOKEN=
# Цена одной дополнительной версии сверх лимита, в Telegram Stars (XTR)
# или в минимальных единицах валюты провайдера.
PAID_VERSION_PRICE_XTR=199
