BOT_TOKEN=
ANTHROPIC_API_KEY=

# Опционально — персистентное хранилище FSM (переживает рестарт процесса).
# Если пусто, используется MemoryStorage (состояния теряются при рестарте).
REDIS_URL=

# Временно скрывают кнопки "Разработать проект" / "Разработать бизнес-план".
# По умолчанию включён только грантовый флоу — бизнес-планы приостановлены
# по просьбе владельца (2026-09-23). Вернуть бизнес-планы: BIZPLAN_FLOW_ENABLED=true.
GRANT_FLOW_ENABLED=true
BIZPLAN_FLOW_ENABLED=false

# Лимит бесплатных ПРОЕКТОВ на аккаунт (по умолчанию 3). Один проект = одна
# заявка одному донору, даже если она требует несколько файлов формы.
FULL_VERSION_LIMIT=3
# Установите true, чтобы лимит реально блокировал старт нового проекта
# (пока false — лимит существует, но не мешает пользоваться ботом).
ENFORCE_FULL_VERSION_LIMIT=false
# ID пользователей Telegram (через запятую), для которых лимит не действует
# никогда, даже при ENFORCE_FULL_VERSION_LIMIT=true — например, владелец бота.
UNLIMITED_USER_IDS=

# Сколько раз бот пытается автоматически исправить найденные red-flags
# перед тем, как показать их пользователю напрямую (по умолчанию 1).
RED_FLAG_AUTOFIX_ATTEMPTS=1

# --- Платежи (выключено по умолчанию) ---
# Установите true вместе с ENFORCE_FULL_VERSION_LIMIT=true, чтобы бот
# реально принимал оплату за проекты сверх лимита (см. billing.py,
# payments.py, agent_router._paywall_or_consume).
PAYMENT_ENABLED=false
# Оставьте пустым для оплаты через Telegram Stars (не требует внешнего
# провайдера), либо укажите токен провайдера из @BotFather -> Payments для
# классической оплаты картой.
PROVIDER_TOKEN=
# Цена одного дополнительного проекта сверх лимита, в Telegram Stars (XTR)
# или в минимальных единицах валюты провайдера. 150 ≈ $3 по ориентировочному
# курсу ~$0.02/Star — свериться в @BotFather -> Payments перед стартом продаж.
PAID_VERSION_PRICE_XTR=150
